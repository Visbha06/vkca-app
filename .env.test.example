# Copy to .env.test for backend pytest runs. Never point this at development data.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5455/academy_test
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=academy_test
DB_PORT=5455

# Use a test-only signing secret; never reuse a deployed secret.
JWT_SECRET=replace-with-a-test-only-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_INACTIVITY_DAYS=7
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# Deterministic provider seam for isolated tests; no Gemini credential needed.
RAG_EMBEDDING_PROVIDER=fake
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSION=1536
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_EMBEDDING_BATCH_SIZE=32
RAG_CHUNKING_VERSION=rag-chunk-v1
RAG_CHUNK_MAX_CHARACTERS=4000
RAG_CHUNK_CONTEXT_CHARACTERS=240
RAG_QUERY_MAX_CHARACTERS=1000
RAG_RESULT_LIMIT_DEFAULT=5
RAG_RESULT_LIMIT_MAX=20

# Disposable local Redis for dispatcher/worker integration tests.
REDIS_URL=redis://localhost:6379/0
BACKGROUND_QUEUE_NAME=vkca-background-test
BACKGROUND_WORKER_MAX_JOBS=4
BACKGROUND_JOB_TIMEOUT_SECONDS=300
BACKGROUND_MAX_ATTEMPTS=5
BACKGROUND_RETRY_BASE_SECONDS=5
BACKGROUND_RETRY_MAX_SECONDS=300
BACKGROUND_RETRY_JITTER_SECONDS=5
BACKGROUND_DISPATCH_BATCH_SIZE=50
BACKGROUND_DISPATCH_POLL_SECONDS=5
BACKGROUND_CLAIM_LEASE_SECONDS=120
BACKGROUND_COMPLETED_RETENTION_DAYS=7
BACKGROUND_DEAD_RETENTION_DAYS=30
