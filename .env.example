# Normal application environment. Backend pytest selects .env.test explicitly.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5455/academy_db
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=academy_db
DB_PORT=5455

# Required: use a unique, high-entropy signing secret in every environment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret

# Authentication defaults; override these only when deployment policy requires it.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_INACTIVITY_DAYS=7
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# RAG indexing defaults. The fake provider is safe for local setup; use gemini
# only with a private credential in a local/deployment environment.
RAG_EMBEDDING_PROVIDER=fake
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSION=1536
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_EMBEDDING_BATCH_SIZE=32
RAG_CHUNKING_VERSION=rag-chunk-v1
RAG_CHUNK_MAX_CHARACTERS=4000
RAG_CHUNK_CONTEXT_CHARACTERS=240
RAG_QUERY_MAX_CHARACTERS=1000
RAG_RESULT_LIMIT_DEFAULT=5
RAG_RESULT_LIMIT_MAX=20

GEMINI_API_KEY=add-key-here
