DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5455/academy_db
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=academy_db
DB_PORT=5455

# Required: use a unique, high-entropy signing secret in every environment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret

# Authentication defaults; override these only when deployment policy requires it.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_INACTIVITY_DAYS=7
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
