DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vkca

# Required: use a unique, high-entropy signing secret in every environment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret

# Authentication defaults; override these only when deployment policy requires it.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_INACTIVITY_DAYS=7
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
